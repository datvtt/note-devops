
#############################################################################################
cat <<EOF > deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: deploy-1   #tên deployment
  namespace: lab #change
  labels:
    app: deploy-1 #tag deployment
spec:
  replicas: 1
  selector:
    matchLabels:
      app: deploy-1 #deployment
  template:
    metadata:
      labels:
        app: deploy-1 #deployment
    spec:
      containers:
        - name: deploy-1 #deployment
          image: 872515274284.dkr.ecr.ap-southeast-1.amazonaws.com/datvtt:1.0.97f8480  #tên của ECR
          ports:
            - containerPort: 8080 #port trong container
          resources:
            requests:
              cpu: 500m
              memory: 1024Mi
            limits:
              cpu: 1000m
              memory: 2048Mi
EOF
#############################################################################################
cat <<EOF > service.yaml
apiVersion: v1
kind: Service
metadata:
  name: deploy-1-svc #tên service
  namespace: lab #tên namespace
spec:
  selector:
    app: deploy-1 #tên deployment
  ports:
    - port: 80 #port bên ngoài service
      targetPort: 8080 #port bên trong container
      protocol: TCP
  type: ClusterIP
EOF
#############################################################################################
cat <<EOF > ingress.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: deploy-1-ingress #change
  namespace: lab #change
  annotations:
    kubernetes.io/ingress.class: "nginx"
    cert-manager.io/cluster-issuer: "letsencrypt-http" #thay tên theo ssl
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
spec:
  tls:
    - hosts:
        - java.showtech.cloud
      secretName: deploy-1-tls #thay theo mỗi tls
  rules:
    - host: java.showtech.cloud
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: deploy-1-svc  #thay theo service
                port:
                  number: 80 #port gắn với port bên ngoài service
EOF
#############################################################################################

              

